# Supabase project credentials.
# The scraper writes through the service-role key, so keep this file private
# and never commit a real .env. Without these two variables the CLI only runs
# with --dry-run.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional outgoing proxy for Playwright, e.g. http://user:pass@host:port
# Leave blank/unset to connect directly.
PROXY_SERVER=

# Optional: path to a system Chromium/Chrome binary. Only needed when
# `npx playwright install chromium` is unavailable (e.g. offline dev machines),
# for example /usr/bin/chromium or /snap/bin/chromium. Leave blank normally.
CHROMIUM_EXECUTABLE_PATH=
