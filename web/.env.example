# Supabase connection (optional).
#
# When BOTH of these are set, the app reads live data from Supabase using the
# public anon key (read-only). When either is missing, the app automatically
# falls back to the built-in demo dataset in `lib/demo-data.ts` and shows a
# subtle "demo data" badge. No writes are ever performed from the web app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
